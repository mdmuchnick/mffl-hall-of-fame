---
import PhotoTrigger from "./PhotoTrigger.astro";
interface Props { eyebrow?: string; title: string; lede?: string; avatar?: string; avatarFull?: string }
const { eyebrow, title, lede, avatar, avatarFull } = Astro.props;
---
<header class="ph">
  {avatar && (
    avatarFull
      ? <PhotoTrigger class="ph-avatar" src={avatar} full={avatarFull} alt={title} />
      : <img class="ph-avatar" src={avatar} alt="" />
  )}
  <div class="ph-text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
  <img class="ph-crest" src="/mffl-crest.png" alt="" aria-hidden="true" width="110" height="137" />
</header>
<style>
  .ph {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-lg);
    padding: var(--gap-xl) 0 var(--gap-lg);
  }
  .ph-text { min-width: 0; }
  .lede { font-size: var(--step-1); color: var(--text-muted); margin-top: 1rem; }
  :global(.ph-avatar) {
    flex: none;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--orchid-dim);
    margin-top: 0.15rem;
  }
  .ph-crest {
    flex: none;
    width: 110px;
    height: auto;
    margin-top: 0.15rem;
  }
  @media (max-width: 640px) {
    .ph-crest { width: 64px; }
    :global(.ph-avatar) { width: 56px; height: 56px; }
  }
</style>
