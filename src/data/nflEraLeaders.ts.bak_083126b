/* Real-world NFL career leaders by position, bounded to the 2002-2025 seasons
   — the span of MFFL's existence (2026 draft only just happened, so 2025 is
   the last completed season). This is trivia/reference content, NOT derived
   from the league archive and NOT tied to who any MFFL manager drafted.
   Intentionally separate from league.ts, same pattern as hallOfFame.ts.

   Sourced 2026-08-31 via StatMuse (official NFL play-by-play data),
   cross-checked against Pro-Football-Reference career spans for players
   whose careers start before 2002 or continue past 2025. Regular season
   only (playoffs excluded). Where a player's real career extends outside
   the window, only the portion played within 2002-2025 is counted.

   "Est. Fantasy Pts" is NOT any specific league's real historical scoring —
   MFFL's settings changed across 25 seasons. It's a single standard
   non-PPR convention applied uniformly for comparison purposes:
     QB:  1 pt / 25 pass yds, 4 pts / pass TD, -2 pts / INT,
          1 pt / 10 rush yds, 6 pts / rush TD
     RB/WR/TE: 1 pt / 10 rush yds, 6 pts / rush TD,
          1 pt / 10 rec yds, 6 pts / rec TD (no points per reception)
     K:   3 pts / FG made (flat, no distance tiers), 1 pt / XP made
     DEF: 1 pt / sack, 2 pts / INT, 2 pts / fumble recovery,
          6 pts / defensive or special-teams TD
          (points-allowed bonus scoring is excluded — it does not aggregate
          cleanly across 24 seasons from public sources) */

export interface QbLeader {
  rank: number;
  name: string;
  passYds: number;
  passTd: number;
  rushYds: number;
  rushTd: number;
  ints: number;
  fantasyPts: number;
}

export interface RbLeader {
  rank: number;
  name: string;
  rushYds: number;
  rushTd: number;
  rec: number;
  recYds: number;
  totalTd: number;
  fantasyPts: number;
}

export interface ReceiverLeader {
  rank: number;
  name: string;
  rec: number;
  recYds: number;
  recTd: number;
  ypr: number;
  fantasyPts: number;
}

export interface KLeader {
  rank: number;
  name: string;
  fgMade: number;
  fgAtt: number;
  fgPct: number;
  xpMade: number;
  points: number;
  fantasyPts: number;
}

export interface DefLeader {
  rank: number;
  team: string;
  sacks: number;
  ints: number;
  fumbleRec: number;
  defTd: number;
  fantasyPts: number;
}

