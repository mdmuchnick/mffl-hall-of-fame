export const commas = (n: number): string => Math.round(n).toLocaleString("en-US");
export const oneDecimal = (n: number): string => n.toFixed(1);

/* ------------------------------------------------------------------ */
/* career player records — the single-stat leader across all four      */
/* position tables above, for the Record Book page. Computed (not      */
/* hardcoded) so it always matches whatever is on the All-Time tab.    */
/* ------------------------------------------------------------------ */

export interface CareerPlayerRecord {
  label: string;
  player: string;
  value: string;
  detail: string;
}

export function careerPlayerRecords(): CareerPlayerRecord[] {
  const passYds = [...eraQbLeaders].sort((a, b) => b.passYds - a.passYds)[0];
  const passTd = [...eraQbLeaders].sort((a, b) => b.passTd - a.passTd)[0];
  const rushYds = [...eraRbLeaders].sort((a, b) => b.rushYds - a.rushYds)[0];

  const receivers = [
    ...eraRbLeaders.map((p) => ({ name: p.name, rec: p.rec, recYds: p.recYds })),
    ...eraWrLeaders.map((p) => ({ name: p.name, rec: p.rec, recYds: p.recYds })),
    ...eraTeLeaders.map((p) => ({ name: p.name, rec: p.rec, recYds: p.recYds })),
  ];
  const mostRec = [...receivers].sort((a, b) => b.rec - a.rec)[0];
  const mostRecYds = [...receivers].sort((a, b) => b.recYds - a.recYds)[0];

  const nonQbTds = [
    ...eraRbLeaders.map((p) => ({ name: p.name, td: p.totalTd })),
    ...eraWrLeaders.map((p) => ({ name: p.name, td: p.recTd })),
    ...eraTeLeaders.map((p) => ({ name: p.name, td: p.recTd })),
  ];
  const mostTd = [...nonQbTds].sort((a, b) => b.td - a.td)[0];

  return [
    { label: "Most Passing Yards", player: passYds.name, value: commas(passYds.passYds), detail: "2002–2025 career" },
    { label: "Most Passing TDs", player: passTd.name, value: `${passTd.passTd}`, detail: "2002–2025 career" },
    { label: "Most Rushing Yards", player: rushYds.name, value: commas(rushYds.rushYds), detail: "2002–2025 career" },
    { label: "Most Receptions", player: mostRec.name, value: commas(mostRec.rec), detail: "2002–2025 career" },
    { label: "Most Receiving Yards", player: mostRecYds.name, value: commas(mostRecYds.recYds), detail: "2002–2025 career" },
    { label: "Most TDs (non-QB)", player: mostTd.name, value: `${mostTd.td}`, detail: "2002–2025 career, rushing + receiving" },
  ];
}
