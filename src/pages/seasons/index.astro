---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { seasons, managerName, fmt } from "../../data/league";
import type { Season } from "../../data/league";

const championTeamName = (s: Season) =>
  s.teams.find((t) => t.manager === s.champion)?.teamName ?? "";
const mvpOwnerTeamName = (s: Season) =>
  s.mvp ? s.teams.find((t) => t.manager === s.mvp!.manager)?.teamName ?? "" : "";
---
<Base title="Seasons">
  <PageHeader eyebrow="The archive" title="Seasons" lede="One page per year. Final standings, every week's scores, the bracket, and the draft board where Yahoo still has one." />
  <ul class="list">
    {seasons.map((s) => (
      <li>
        <a href={`/seasons/${s.year}`}>
          <span class="yr num">{s.year}</span>
          <span class="body">
            <span class="champ">
              {managerName(s.champion)}
              {championTeamName(s) && <span class="team">&ldquo;{championTeamName(s)}&rdquo;</span>}
            </span>
            <span class="sub dim">
              def. {managerName(s.runnerUp)} {fmt(s.championshipScore[0])}–{fmt(s.championshipScore[1])}
              · {s.teamCount} teams{s.draft.length === 0 ? " · no draft board" : ""}
            </span>
            {s.mvp && (
              <span class="sub mvp-line">
                MVP: {s.mvp.player} ({s.mvp.position}) — {managerName(s.mvp.manager)}
                {mvpOwnerTeamName(s) && <span class="team">&ldquo;{mvpOwnerTeamName(s)}&rdquo;</span>}
              </span>
            )}
          </span>
          <span class="pills">
            <span class="pill gold">Champion</span>
            {s.mvp && <span class="pill mvp">MVP</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
  <style>
    .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
    .list a {
      display: grid;
      grid-template-columns: 4.5rem 1fr auto;
      gap: var(--gap);
      align-items: center;
      padding: 0.9rem 1.1rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      text-decoration: none;
    }
    .list a:hover { border-color: var(--orchid); background: var(--surface-raised); }
    .yr { font-family: var(--font-data); font-weight: 700; font-size: 1.25rem; color: var(--text); }
    .body { display: grid; gap: 0.1rem; }
    .champ { color: var(--text); font-weight: 600; }
    .champ .team {
      margin-left: 0.45rem;
      font-family: var(--font-data);
      font-weight: 500;
      font-size: 0.8125rem;
      color: var(--text-muted);
    }
    .sub { font-size: 0.8125rem; }
    .mvp-line { color: var(--text-muted); }
    .mvp-line .team {
      margin-left: 0.35rem;
      font-family: var(--font-data);
      font-weight: 500;
      font-size: 0.8125rem;
    }
    .pills { display: grid; gap: 0.35rem; justify-items: end; }
    .pill.mvp { background: var(--surface-raised); border: 1px solid var(--orchid); color: var(--orchid); }
    @media (max-width: 560px) {
      .list a { grid-template-columns: 3.5rem 1fr; }
      .list .pill, .list .pills { display: none; }
    }
  </style>
</Base>
