---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { careerRecords, recordLine, fmt, pct } from "../data/league";
import {
  eraQbColumns,
  eraRbColumns,
  eraWrColumns,
  eraTeColumns,
  eraKColumns,
  eraDefColumns,
  commas,
  oneDecimal,
} from "../data/nflEraLeaders";
const rows = careerRecords();
---
<Base title="All-Time Standings">
  <PageHeader
    eyebrow="Career"
    title="All-Time Standings"
    lede="Every regular-season and playoff game since the league started. Points per game is there because a 13-week season and a 14-week season do not compare on totals alone."
  />
  <div class="table-wrap">
    <table class="sortable-table" id="standings-table">
      <thead>
        <tr>
          <th data-sort="rank" data-type="num" aria-sort="ascending">#</th>
          <th data-sort="name" data-type="text">Manager</th>
          <th class="n" data-sort="seasons" data-type="num">Seasons</th>
          <th class="n" data-sort="record" data-type="num">Record</th>
          <th class="n" data-sort="winPct" data-type="num">Win %</th>
          <th class="n" data-sort="titles" data-type="num">Titles</th>
          <th class="n" data-sort="playoffs" data-type="num">Playoffs</th>
          <th class="n" data-sort="pointsFor" data-type="num">Points for</th>
          <th class="n" data-sort="ppg" data-type="num">Pts / game</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r, i) => (
          <tr>
            <td class="n dim" data-sort="rank" data-value={i + 1}>{i + 1}</td>
            <td class="name" data-sort="name" data-value={r.name.toLowerCase()}>
              <a href={`/managers/${r.slug}`}>{r.name}</a>
            </td>
            <td class="n" data-sort="seasons" data-value={r.seasons}>{r.seasons}</td>
            <td class="n" data-sort="record" data-value={r.wins + r.ties * 0.5}>
              {recordLine(r.wins, r.losses, r.ties)}
            </td>
            <td class="n" data-sort="winPct" data-value={r.winPct}>{pct(r.winPct)}</td>
            <td class="n" data-sort="titles" data-value={r.titles}>{r.titles > 0 ? r.titles : "—"}</td>
            <td class="n" data-sort="playoffs" data-value={r.playoffAppearances}>{r.playoffAppearances}</td>
            <td class="n" data-sort="pointsFor" data-value={r.pointsFor}>{fmt(r.pointsFor)}</td>
            <td class="n" data-sort="ppg" data-value={r.pointsPerGame}>{fmt(r.pointsPerGame)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <section class="era-leaders">
    <PageHeader
      eyebrow="The NFL, 2002–present"
      title="Career Leaders by Position"
      lede="Real NFL statistics, not MFFL rosters — the top players at each position by cumulative production across the league's entire lifespan, 2002 through the 2025 season (2026 has barely kicked off). Where a player's own career started earlier or is still going, only the games played inside that window count. Fantasy points use MFFL's current (2026) scoring — full PPR, 6 points for every touchdown — applied the same way across all 25 seasons, even though the league's real settings have changed over time. Click a column header to jump to that stat's own top 10 (top 5 for defense) — each column is a different leaderboard, not just a re-sort of the same players, so the row set changes when you switch columns."
    />

    <div class="position-block">
      <h3>Quarterbacks</h3>
      <div class="table-wrap">
        <table class="sortable-table era-table" id="qb-table">
          <thead>
            <tr>
              <th></th>
              <th data-type="text">Player</th>
              <th class="n" data-col="passYds">Pass Yds</th>
              <th class="n">Pass TD</th>
              <th class="n" data-col="rushYds">Rush Yds</th>
              <th class="n">Rush TD</th>
              <th class="n">INT</th>
              <th class="n" data-col="fantasyPts" aria-sort="descending">Fantasy Pts</th>
            </tr>
          </thead>
          {eraQbColumns.map((col) => (
            <tbody data-col={col.key} hidden={col.key !== "fantasyPts"}>
              {col.rows.map((p, i) => (
                <tr>
                  <td class="n dim">{i + 1}</td>
                  <td class="name">{p.player}</td>
                  <td class="n">{commas(p.passYds)}</td>
                  <td class="n">{p.passTd}</td>
                  <td class="n">{commas(p.rushYds)}</td>
                  <td class="n">{p.rushTd}</td>
                  <td class="n">{p.ints}</td>
                  <td class="n">{oneDecimal(p.fantasyPts)}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>

    <div class="position-block">
      <h3>Running Backs</h3>
      <div class="table-wrap">
        <table class="sortable-table era-table" id="rb-table">
          <thead>
            <tr>
              <th></th>
              <th data-type="text">Player</th>
              <th class="n" data-col="rushYds">Rush Yds</th>
              <th class="n">Rush TD</th>
              <th class="n">Rec</th>
              <th class="n" data-col="recYds">Rec Yds</th>
              <th class="n" data-col="totalTd">Total TD</th>
              <th class="n" data-col="fantasyPts" aria-sort="descending">Fantasy Pts</th>
            </tr>
          </thead>
          {eraRbColumns.map((col) => (
            <tbody data-col={col.key} hidden={col.key !== "fantasyPts"}>
              {col.rows.map((p, i) => (
                <tr>
                  <td class="n dim">{i + 1}</td>
                  <td class="name">{p.player}</td>
                  <td class="n">{commas(p.rushYds)}</td>
                  <td class="n">{p.rushTd}</td>
                  <td class="n">{commas(p.rec)}</td>
                  <td class="n">{commas(p.recYds)}</td>
                  <td class="n">{p.totalTd}</td>
                  <td class="n">{oneDecimal(p.fantasyPts)}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>

    <div class="position-block">
      <h3>Wide Receivers</h3>
      <div class="table-wrap">
        <table class="sortable-table era-table" id="wr-table">
          <thead>
            <tr>
              <th></th>
              <th data-type="text">Player</th>
              <th class="n" data-col="rec">Rec</th>
              <th class="n" data-col="recYds">Rec Yds</th>
              <th class="n" data-col="recTd">Rec TD</th>
              <th class="n" data-col="fantasyPts" aria-sort="descending">Fantasy Pts</th>
            </tr>
          </thead>
          {eraWrColumns.map((col) => (
            <tbody data-col={col.key} hidden={col.key !== "fantasyPts"}>
              {col.rows.map((p, i) => (
                <tr>
                  <td class="n dim">{i + 1}</td>
                  <td class="name">{p.player}</td>
                  <td class="n">{commas(p.rec)}</td>
                  <td class="n">{commas(p.recYds)}</td>
                  <td class="n">{p.recTd}</td>
                  <td class="n">{oneDecimal(p.fantasyPts)}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>

    <div class="position-block">
      <h3>Tight Ends</h3>
      <div class="table-wrap">
        <table class="sortable-table era-table" id="te-table">
          <thead>
            <tr>
              <th></th>
              <th data-type="text">Player</th>
              <th class="n" data-col="rec">Rec</th>
              <th class="n" data-col="recYds">Rec Yds</th>
              <th class="n" data-col="recTd">Rec TD</th>
              <th class="n" data-col="fantasyPts" aria-sort="descending">Fantasy Pts</th>
            </tr>
          </thead>
          {eraTeColumns.map((col) => (
            <tbody data-col={col.key} hidden={col.key !== "fantasyPts"}>
              {col.rows.map((p, i) => (
                <tr>
                  <td class="n dim">{i + 1}</td>
                  <td class="name">{p.player}</td>
                  <td class="n">{commas(p.rec)}</td>
                  <td class="n">{commas(p.recYds)}</td>
                  <td class="n">{p.recTd}</td>
                  <td class="n">{oneDecimal(p.fantasyPts)}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>

    <div class="position-block">
      <h3>Kickers</h3>
      <div class="table-wrap">
        <table class="sortable-table era-table" id="k-table">
          <thead>
            <tr>
              <th></th>
              <th data-type="text">Player</th>
              <th class="n" data-col="fgMade">FG Made</th>
              <th class="n">FG Att</th>
              <th class="n">XP Made</th>
              <th class="n" data-col="fantasyPts" aria-sort="descending">Fantasy Pts</th>
            </tr>
          </thead>
          {eraKColumns.map((col) => (
            <tbody data-col={col.key} hidden={col.key !== "fantasyPts"}>
              {col.rows.map((p, i) => (
                <tr>
                  <td class="n dim">{i + 1}</td>
                  <td class="name">{p.player}</td>
                  <td class="n">{p.fgMade}</td>
                  <td class="n">{p.fgAtt}</td>
                  <td class="n">{p.xpMade}</td>
                  <td class="n">{oneDecimal(p.fantasyPts)}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>

    <div class="position-block">
      <h3>Team Defense / Special Teams</h3>
      <p class="position-note">Top 10 only. Fantasy points cover sacks, interceptions, fumble recoveries, and defensive touchdowns only — points-allowed bonus scoring isn't included, since it doesn't aggregate cleanly across 24 seasons from public sources.</p>
      <div class="table-wrap">
        <table class="sortable-table era-table" id="def-table">
          <thead>
            <tr>
              <th></th>
              <th data-type="text">Team</th>
              <th class="n" data-col="sacks">Sacks</th>
              <th class="n" data-col="ints">INT</th>
              <th class="n">Fumble Rec</th>
              <th class="n">Def TD</th>
              <th class="n" data-col="fantasyPts" aria-sort="descending">Fantasy Pts</th>
            </tr>
          </thead>
          {eraDefColumns.map((col) => (
            <tbody data-col={col.key} hidden={col.key !== "fantasyPts"}>
              {col.rows.map((p, i) => (
                <tr>
                  <td class="n dim">{i + 1}</td>
                  <td class="name">{p.team}</td>
                  <td class="n">{commas(p.sacks)}</td>
                  <td class="n">{p.ints}</td>
                  <td class="n">{p.fumbleRec}</td>
                  <td class="n">{p.defTd}</td>
                  <td class="n">{commas(p.fantasyPts)}</td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </section>
</Base>

<script>
  function initSortableTable(table: HTMLTableElement) {
    const headers = Array.from(table.querySelectorAll<HTMLTableCellElement>("thead th"));
    const tbody = table.querySelector("tbody");
    if (!tbody) return;

    let currentKey = headers.find((h) => h.getAttribute("aria-sort"))?.dataset.sort ?? headers[0]?.dataset.sort ?? "";
    let currentDir: 1 | -1 = headers.find((h) => h.dataset.sort === currentKey)?.getAttribute("aria-sort") === "descending" ? -1 : 1;

    function applySort(key: string, dir: 1 | -1) {
      const rows = Array.from(tbody!.querySelectorAll("tr"));
      const type = headers.find((h) => h.dataset.sort === key)?.dataset.type ?? "text";

      rows.sort((a, b) => {
        const av = a.querySelector<HTMLElement>(`[data-sort="${key}"]`)?.dataset.value ?? "";
        const bv = b.querySelector<HTMLElement>(`[data-sort="${key}"]`)?.dataset.value ?? "";
        if (type === "num") return (parseFloat(av) - parseFloat(bv)) * dir;
        return av.localeCompare(bv) * dir;
      });

      rows.forEach((row) => tbody!.appendChild(row));

      headers.forEach((h) => {
        if (h.dataset.sort === key) {
          h.setAttribute("aria-sort", dir === 1 ? "ascending" : "descending");
        } else {
          h.removeAttribute("aria-sort");
        }
      });
    }

    headers.forEach((h) => {
      h.tabIndex = 0;
      h.setAttribute("role", "button");
      const onActivate = () => {
        const key = h.dataset.sort!;
        if (key === currentKey) {
          currentDir = currentDir === 1 ? -1 : 1;
        } else {
          currentKey = key;
          // Text columns default ascending; numeric columns default descending
          // (best record / most points first is the useful starting view).
          currentDir = h.dataset.type === "text" ? 1 : -1;
        }
        applySort(currentKey, currentDir);
      };
      h.addEventListener("click", onActivate);
      h.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          onActivate();
        }
      });
    });
  }

  // Era-leaders tables: clicking a header swaps the whole row set to that
  // column's own top-10/top-5 leaderboard (descending only — there's no
  // "bottom 10" view). Each column's rows are pre-rendered into their own
  // <tbody data-col="key">; the header click just shows the matching one.
  function initEraTable(table: HTMLTableElement) {
    const headers = Array.from(table.querySelectorAll<HTMLTableCellElement>("thead th[data-col]"));
    const tbodies = Array.from(table.querySelectorAll<HTMLTableSectionElement>("tbody[data-col]"));
    if (!headers.length || !tbodies.length) return;

    function showColumn(key: string) {
      tbodies.forEach((tb) => {
        tb.hidden = tb.dataset.col !== key;
      });
      headers.forEach((h) => {
        if (h.dataset.col === key) {
          h.setAttribute("aria-sort", "descending");
        } else {
          h.removeAttribute("aria-sort");
        }
      });
    }

    headers.forEach((h) => {
      h.tabIndex = 0;
      h.setAttribute("role", "button");
      const onActivate = () => showColumn(h.dataset.col!);
      h.addEventListener("click", onActivate);
      h.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          onActivate();
        }
      });
    });
  }

  document.querySelectorAll<HTMLTableElement>("table.sortable-table:not(.era-table)").forEach(initSortableTable);
  document.querySelectorAll<HTMLTableElement>("table.era-table").forEach(initEraTable);
</script>

<style>
  .sortable-table thead th {
    cursor: pointer;
    user-select: none;
    transition: color 0.15s ease;
  }
  .sortable-table thead th:hover {
    color: var(--lavender);
  }
  .sortable-table thead th:focus-visible {
    outline: 2px solid var(--orchid-bright);
    outline-offset: -2px;
  }
  .sortable-table thead th[aria-sort]::after {
    content: "";
    display: inline-block;
    margin-left: 0.35em;
    border: 4px solid transparent;
  }
  .sortable-table thead th[aria-sort="ascending"]::after {
    border-bottom-color: var(--orchid-bright);
    transform: translateY(-2px);
  }
  .sortable-table thead th[aria-sort="descending"]::after {
    border-top-color: var(--orchid-bright);
    transform: translateY(2px);
  }
  .era-table thead th:not([data-col]) {
    cursor: default;
  }
  .era-table thead th:not([data-col]):hover {
    color: inherit;
  }

  .era-leaders {
    margin-top: var(--step-6, 3rem);
  }
  .position-block {
    margin-top: var(--step-5, 2rem);
  }
  .position-block h3 {
    font-family: var(--font-display);
    letter-spacing: 0.02em;
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .position-note {
    color: var(--text-muted);
    font-size: var(--step--1, 0.8125rem);
    max-width: 60ch;
    margin: 0 0 0.75rem;
  }
</style>
